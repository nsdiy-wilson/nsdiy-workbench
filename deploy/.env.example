# nsdiy-workbench 环境变量配置模板
#
# 使用方式：
#   - 部署机：install.sh 首次安装时把本文件复制为 .env 并注入随机 JWT 密钥（升级永不覆盖 .env）
#   - 本地开发：cp deploy/.env.example server/.env，然后按需修改（从 server/ 目录启动时会被自动找到）
#
# 取值优先级：进程环境变量 > .env 文件 > 程序内置默认
# 本文件里注释掉的项 = 未配置 = 使用内置默认值；取消注释并填值即可覆盖默认值。
# 只有 .env 本名参与运行，本模板运行时不读取（升级时无需同步到部署机）。

# ===== 必填：未填或仍为占位值时服务拒绝启动 =====

# JWT 签名密钥：生产环境必须替换为随机字符串（至少 32 字节）
# 生成命令: openssl rand -base64 32
JWT_SIGNING_KEY=REPLACE_ME_WITH_RANDOM_KEY

# 数据库类型：当前取值 sqlite
DB_TYPE=sqlite

# 数据库文件目录（SQLite 库落于此）。**必须是绝对路径**：写相对路径启动即拒绝，可指向独立磁盘。
# 下面给出两种系统的样式，**按所在系统保留一行、注释掉另一行**：
#
# Linux（部署机 / 生产）
SERVER_DB_PATH=/opt/nsdiy-workbench/data/db
# Windows（盘符不能省，正反斜杠均可，写成 D:\nsdiy-workbench\data\db 也可以。
# 注意 /opt/... 在 Windows 上不是绝对路径：它会跟随进程所在盘解析成 D:\opt\...，
# 数据位置还会随启动目录漂移）
#SERVER_DB_PATH=D:/nsdiy-workbench/data/db

# 上传文件目录。**必须是绝对路径**，可与数据库目录分开指向不同磁盘，同样按系统二选一：
#
# Linux（部署机 / 生产）
SERVER_UPLOAD_PATH=/opt/nsdiy-workbench/data/uploads
# Windows（盘符不能省，正反斜杠均可）
#SERVER_UPLOAD_PATH=D:/nsdiy-workbench/data/uploads

# ===== 以下全部可选：取消注释（去掉行首 #）即覆盖内置默认 =====

# --- 服务 ---
# 应用名称
#SERVER_APP_NAME=nsdiy-workbench
# HTTP 监听地址
#SERVER_ADDR=:9527

# --- JWT ---
# token 有效期
#JWT_EXPIRES_TIME=168h

# --- CORS ---
# 允许的跨域来源，逗号分隔（生产环境填写实际域名）；不配置表示仅允许同源
#CORS_ALLOWED_ORIGINS=https://example.com,https://www.example.com

# --- 日志 ---
# 日志级别 debug/info/warn/error
#LOG_LEVEL=info
# 日志文件；为空输出到 stdout（推荐，由 systemd journal 托管切割）
#LOG_FILENAME=

# --- 上传图片限制（<=0 表示不限制）---
#UPLOAD_MAX_FILE_SIZE=10485760
#UPLOAD_MIN_WIDTH=400
#UPLOAD_MIN_HEIGHT=200
#UPLOAD_MAX_WIDTH=4096
#UPLOAD_MAX_HEIGHT=4096
#UPLOAD_MAX_PIXELS=20000000

# --- AI 能力（任何 OpenAI 兼容的 /chat/completions 接口）---
# 本段是出厂默认与兜底来源：管理端「AI 智能 → AI 配置」保存的值落在数据库 ai_config 表，
# 该表有记录时整体以它为准，本段仅在无记录时生效。密钥在库中以 AES-GCM 密文存储，
# 建议留空改为在管理端填写。
# 接口基础地址，末尾不带 /
#AI_BASE_URL=https://api.deepseek.com/v1
# 密钥：留空表示未配置，AI 功能不可用
#AI_API_KEY=
# 模型名，如 deepseek-chat；留空表示未配置，AI 功能不可用
#AI_MODEL=
# 单次调用超时（秒）
#AI_TIMEOUT=60
# 摘要队列的消费速率上限（每分钟最多发起的 AI 调用次数），区间 1~60
#AI_QPM=30
# 生成文章摘要时使用的 system 提示词；留空则回落到内置默认
#AI_SUMMARY_PROMPT=

# --- 站点身份（前台页眉、Hero、文档 title、作者卡片与页脚的展示来源）---
# 本段是出厂默认与兜底来源：管理端「系统设置 → 站点配置」保存的值落在数据库 site_config 表，
# 该表有记录时整体以它为准，本段仅在无记录时生效。
# 站点名称：前台标题、页眉与文档 title 用
#SITE_NAME=NSDIY
# 副标题 / 站点描述：前台 Hero 与 meta description 用
#SITE_DESCRIPTION=独立站技术笔记
# 站点域名（含协议，如 https://example.com；不要带末尾斜杠或路径）
# sitemap / canonical / OG / RSS 都需要它来拼绝对 URL
#SITE_DOMAIN=https://example.com
# ICP 备案号：前台页脚展示，没有就不填
#SITE_ICP=
# 作者署名：前台作者卡片用
#SITE_AUTHOR=Wilson
# 联系邮箱：前台联系方式用，没有就不填
#SITE_CONTACT_EMAIL=
